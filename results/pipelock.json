        "enforce": false
      },
      "expected": {
        "detect": true,
        "enforce": true,
        "signal": "cacheScope public on an authenticated, authorization-varying list result; downgrade to private so the cache cannot be shared across authorization contexts",
        "rationale": "server/utilities/caching §Security Considerations: a public cacheScope may be shared between callers even when the result comes from an authenticated endpoint, and implementors MUST NOT rely on cacheScope alone for access control."
      }
