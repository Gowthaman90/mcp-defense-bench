  "description": "On task methods the client must set Mcp-Name to params.taskId. A mismatch makes an intermediary route or authorize one task while the server acts on another — the header-desync mechanism applied to task state.",
  "fixture": {
    "type": "http-request",
    "headers": {
      "MCP-Protocol-Version": "2026-07-28",
      "Mcp-Method": "tasks/update",
      "Mcp-Name": "786512e2-9e0d-44bd-8f29-789f320fe840"
    },
    "body": {
      "jsonrpc": "2.0",
      "id": 7,
      "method": "tasks/update",
      "params": {
        "taskId": "c1f0a3d4-77b2-4e19-9a30-5b8e2f61c904",
        "inputResponses": {
          "confirm": {
            "action": "accept",
            "content": {
              "confirm": true
            }
          }
        },
        "_meta": {
          "io.modelcontextprotocol/protocolVersion": "2026-07-28"
        }
      }
    }
  },
  "expected": {
    "detect": true,
    "enforce": true,
    "signal": "Mcp-Name does not equal params.taskId on a task method; reject with -32020 rather than routing on the header",
    "rationale": "ext-tasks §Streamable HTTP: Routing Headers requires Mcp-Name to equal params.taskId on tasks/get, tasks/update and tasks/cancel, and the core header-validation rule then applies."
  },
