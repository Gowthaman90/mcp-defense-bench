{
  "vector": "requeststate-forgery",
  "id": "requeststate-forgery/001-unprotected-state-tamper",
  "status": "staged-unscored",
  "appliesTo": [
    "2026-07-28"
  ],
  "severity": "high",
  "description": "An MRTR requestState blob is base64 JSON with no integrity protection. The caller edits the approval decision and the authorized principal inside it and replays the retry. A conforming server rejects it; an unprotected one honours the forged state.",
  "fixture": {
    "type": "mrtr-retry",
    "issued": {
      "resultType": "input_required",
      "inputRequests": {
        "confirm_transfer": {
          "method": "elicitation/create",
          "params": {
            "mode": "form",
            "message": "Confirm this transfer?",
            "requestedSchema": {
              "type": "object",
              "properties": {
                "confirm": {
                  "type": "boolean"
                }
              },
              "required": [
                "confirm"
              ]
            }
          }
        }
      },
      "requestState": "eyJwcmluY2lwYWwiOiJhbGljZSIsImFwcHJvdmVkIjpmYWxzZSwiYW1vdW50Ijo1MH0="
    },
    "tamperedRetry": {
      "method": "tools/call",
      "params": {
        "name": "transfer_funds",
        "arguments": {
          "amount": 50
        },
        "inputResponses": {
          "confirm_transfer": {
            "action": "accept",
            "content": {
              "confirm": true
            }
          }
        },
        "requestState": "eyJwcmluY2lwYWwiOiJib2IiLCJhcHByb3ZlZCI6dHJ1ZSwiYW1vdW50Ijo1MDAwfQ=="
      }
    }
  },
  "expected": {
    "detect": true,
    "enforce": true,
    "signal": "requestState carries authorization-relevant fields without HMAC/AEAD integrity protection, and the retry presents a modified blob",
    "rationale": "patterns/mrtr §Server Requirements 4: servers MUST treat requestState as attacker-controlled and, where it influences authorization, MUST protect its integrity and MUST reject state that fails verification."
  },
  "benignControl": {
    "type": "mrtr-retry",
    "issued": {
      "resultType": "input_required",
      "inputRequests": {
        "confirm_transfer": {
          "method": "elicitation/create",
          "params": {
            "mode": "form",
            "message": "Confirm this transfer?",
            "requestedSchema": {
              "type": "object",
              "properties": {
                "confirm": {
                  "type": "boolean"
                }
              },
              "required": [
                "confirm"
              ]
            }
          }
        }
      },
      "requestState": "AEAD:v1:v9Qm3v0h1YQ0h9m3.5cGh0aXNpc2FuYXV0aGVudGljYXRlZGJsb2I"
    },
    "tamperedRetry": {
      "method": "tools/call",
      "params": {
        "name": "transfer_funds",
        "arguments": {
          "amount": 50
        },
        "inputResponses": {
          "confirm_transfer": {
            "action": "accept",
            "content": {
              "confirm": true
            }
          }
        },
        "requestState": "AEAD:v1:v9Qm3v0h1YQ0h9m3.5cGh0aXNpc2FuYXV0aGVudGljYXRlZGJsb2I"
      }
    },
    "expected": {
      "detect": false,
      "enforce": false
    }
  },
