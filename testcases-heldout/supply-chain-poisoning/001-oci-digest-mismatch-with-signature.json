{
  "vector": "supply-chain-poisoning",
  "id": "heldout/supply-chain-poisoning/001-oci-digest-mismatch-with-signature",
  "heldout": true,
  "family": "D",
  "severity": "high",
  "description": "Signed provenance exists but attests a different digest than the artifact the registry pointer resolved to.",
  "fixture": {
    "type": "registry-resolution",
    "entry": {
      "name": "acme/pdf-tools",
      "pointsTo": "oci://ghcr.io/acme/pdf-tools:2.1.0"
    },
    "resolvedArtifactHash": "sha256:9f1c0e7a",
    "signedProvenance": {
      "sigstore": true,
      "subjectDigest": "sha256:aa77b210"
    }
  },
  "expected": {
    "detect": true,
    "enforce": true,
    "signal": "provenance subject digest does not match the resolved artifact"
  },
  "benignControl": {
    "type": "registry-resolution",
    "entry": {
      "name": "acme/pdf-tools",
      "pointsTo": "oci://ghcr.io/acme/pdf-tools:2.1.0"
    },
    "resolvedArtifactHash": "sha256:9f1c0e7a",
    "signedProvenance": {
      "sigstore": true,
      "subjectDigest": "sha256:9f1c0e7a"
    },
    "expected": {
      "detect": false,
      "enforce": false
    }
  },
  "provenance": "Synthetic held-out (D); provenance gap per Trustworthy MCP Registry."
}
