      "description": "Search for places using Google Places API",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            },
            "description": "Optional center point for the search"
          },
          "radius": {
            "type": "number",
            "description": "Search radius in meters (max 50000)"
          }
